<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Ashstrap</AssemblyName>
    <RootNamespace>Ashstrap</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Ashstrap</Product>
    <!-- Lets the project be built from non-Windows CI as well. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!--
      Self-contained: the .NET runtime is bundled, so nothing has to be installed on the PC
      (the official .NET runtime installer needs administrator rights).
      WPF's few native DLLs (*_cor3.dll) are kept as files next to the exe instead of being
      self-extracted to %TEMP%\.net, so every file the launcher owns lives in its own folder.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF projects don't import System.IO implicitly (it clashes with System.Windows.Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashstrap.Core\Ashstrap.Core.csproj" />
  </ItemGroup>

  <!-- UI shared with the cleanup helper. -->
  <ItemGroup>
    <Page Include="..\Shared\Theme.xaml" Link="Shared\Theme.xaml" />
    <Compile Include="..\Shared\ReportView.cs" Link="Shared\ReportView.cs" />
    <Compile Include="..\Shared\RunningRobloxDialog.cs" Link="Shared\RunningRobloxDialog.cs" />
  </ItemGroup>

</Project>
