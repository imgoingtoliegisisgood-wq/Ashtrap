<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dependency-free test runner (no xUnit/NUnit packages needed, so it builds fully offline).
    Run:  dotnet run -c Release
    Exit code 0 = all tests passed.
    Runs on Windows and Linux; on Linux the Windows-only services are replaced by fakes,
    while all filesystem work uses a real sandbox directory tree.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ashstrap.Core\Ashstrap.Core.csproj" />
  </ItemGroup>

</Project>
